# Red Network (RN) - Server Configuration

# Server Port (automatically assigned on Railway)
PORT=5000

# Access Passcodes
ADMIN_PASSWORD=RNLEADER#1
MEMBER_PASSWORD=redgang2026

# Optional: MongoDB Atlas Connection URI
# If omitted, system runs on local JSON database (server/data/db.json) with zero config!
MONGODB_URI=

# Optional: Discord OAuth & Role Access
# Enter comma-separated Discord user IDs for Leader and Member roles
ADMIN_DISCORD_IDS=
MEMBER_DISCORD_IDS=
VITE_DISCORD_CLIENT_ID=

# API URL for frontend (leave blank in production when served by same Express instance)
VITE_API_URL=
